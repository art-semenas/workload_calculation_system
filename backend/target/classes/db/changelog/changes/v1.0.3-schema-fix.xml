<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
      https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

  <changeSet id="v1.0.3-1" author="copilot">
    <comment>Add missing UNIQUE constraint on divisions.name (db-schema.md)</comment>
    <addUniqueConstraint
        tableName="divisions"
        columnNames="name"
        constraintName="uq_divisions_name"/>
    <rollback>
      <dropUniqueConstraint tableName="divisions" constraintName="uq_divisions_name"/>
    </rollback>
  </changeSet>
</databaseChangeLog>
