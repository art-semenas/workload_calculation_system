      "name": "Auth",
      "item": [
        {
          "name": "01 Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "auth": {
              "type": "noauth",
              "noauth": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n\"email\": \"{{authEmail}}\",\n\"password\": \"{{authPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const token = body?.data?.token;",
                  "pm.test('login returns token', () => pm.expect(token).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('authToken', token);",
                  "pm.collectionVariables.unset('divisionId');",
                  "pm.collectionVariables.unset('branchId');",
                  "pm.collectionVariables.unset('objectId');",
                  "pm.collectionVariables.unset('deviceTypeId');",
                  "pm.collectionVariables.unset('repairTypeId');",
                  "pm.collectionVariables.unset('assignmentId');"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
